# Hacker Agent — environment variables
# Copy to .env and fill in real values. .env is gitignored.

# Path to the SQLite memory database (defaults to data/hacker-memory.db relative to project root)
HACKER_MEMORY_DB=data/hacker-memory.db

# Optional override for the runtime data directory (defaults to data/)
HACKER_DATA_DIR=data

# GitHub personal access token for automation (repo scope minimum)
GITHUB_TOKEN=

# CVE feeds — override only if you need a private/proxied mirror
NVD_API_BASE=https://services.nvd.nist.gov/rest/json/cves/2.0
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# Auto-commit feature branch prefix (CI never pushes to main)
AUTO_COMMIT_BRANCH_PREFIX=auto/
